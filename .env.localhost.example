# Copie para `.env.localhost` na raiz (mesmo dir do docker-compose.yml):
#   cp .env.localhost.example .env.localhost
# Ou deixe `subir-localhost.sh --docker` / `subir-localhost.bat --docker` gerar.
# Usado por: docker compose -f docker-compose.yml -f docker-compose.localhost.yml --env-file .env.localhost up -d --build
# Nunca commitar o .env.localhost real.

DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-com-python-c-import-secrets-print-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
DJANGO_DB_NAME=brd_portal_noticias
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres

# Cache/Celery — host `redis` dentro do compose (não localhost).
DJANGO_CACHE_BACKEND=redis
DJANGO_CACHE_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

FRONTEND_BASE_URL=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@brdportalnoticias.local
# P1-15b — destino das mensagens de `POST /api/contato/`. Vazio/não preenchido
# = o endpoint responde 503 dizendo o que falta (é o estado atual, porque não
# há chave de e-mail nem domínio verificado). `console` NÃO conta como entrega:
# com DJANGO_EMAIL_BACKEND em console o 503 continua valendo.
CONTATO_DESTINO_EMAIL=
ASSINATURA_PAYMENT_GATEWAY_PROVIDER=manual
ASSINATURA_MP_ACCESS_TOKEN=
ASSINATURA_MP_SANDBOX=true

# OAuth/e-mail/ingestão (equalização 2026-10-09, ver backend/.env.example para
# a documentação completa de cada uma). Vazio é seguro em localhost: Google
# login fica desligado, o Resend não é chamado (cai no console acima) e a
# ingestão sem CATALOGO_NOTICIAS_LLM_API_KEY cai em revisão humana.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RESEND_API_KEY=
TERMOS_VERSAO_ATUAL=1.0
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CATALOGO_NOTICIAS_LLM_API_KEY=
CATALOGO_NOTICIAS_LLM_TETO_GASTO_DIARIO_USD=5.0
FEED_JANELA_HORAS=72
FEED_CACHE_TTL_SEGUNDOS=45
FEED_AUTOCOMPLETE_CACHE_TTL_SEGUNDOS=300
GATING_CACHE_TTL_SEGUNDOS=45

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://web:8000

DOMAIN_API=localhost
DOMAIN_FRONTEND=localhost

# Admin local (usado por `criar_usuario_carga` / ensure_local_admin se existir)
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=LocalAdmin123
