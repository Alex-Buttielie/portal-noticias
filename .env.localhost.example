# Copie para `.env.localhost` na raiz (mesmo dir do docker-compose.yml):
#   cp .env.localhost.example .env.localhost
# Ou deixe `subir-localhost.sh --docker` / `subir-localhost.bat --docker` gerar.
# Usado por: docker compose -f docker-compose.yml -f docker-compose.localhost.yml --env-file .env.localhost up -d --build
# Nunca commitar o .env.localhost real.

DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-com-python-c-import-secrets-print-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
DJANGO_DB_NAME=brd_portal_noticias
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres

# Cache/Celery — host `redis` dentro do compose (não localhost).
DJANGO_CACHE_BACKEND=redis
DJANGO_CACHE_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

FRONTEND_BASE_URL=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@brdportalnoticias.local
ASSINATURA_PAYMENT_GATEWAY_PROVIDER=manual

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://web:8000

DOMAIN_API=localhost
DOMAIN_FRONTEND=localhost

# Observabilidade local (run 20260925-1020-observabilidade):
# Sem Sentry e sem coletor em localhost: os endpoints de diagnóstico existem
# (curl http://localhost:8000/livez e /readyz), mas ficam em loopback e não
# exigem token. O que importa aqui é o log em JSON desligado (para o terminal
# ficar legível) e o watchdog de backup, que é o mesmo script da VPS.
DJANGO_LOG_JSON=false
DJANGO_LOG_LEVEL=INFO
SENTRY_ENVIRONMENT=development
# Alerta de atraso de backup: o watchdog local roda em qualquer ambiente; o
# monitor EXTERNO (cron monitor) é o que cobre VPS morta e só faz sentido onde
# existe VPS.
BACKUP_MAX_AGE_HOURS=26

# Admin local (usado por `criar_usuario_carga` / ensure_local_admin se existir)
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=LocalAdmin123
