      "description": "O feed é o produto. Uma queda aqui com `portal_ready=1` é degradação de conteúdo, não de infraestrutura — e o frontend responde 503 sem nunca servir conteúdo fictício.",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
