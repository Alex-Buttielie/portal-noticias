      },
      "description": "Se a ingestion falha e a fila sobe junto, o worker está consumindo pouco ou não está consumindo.",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
