      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Sinal de EFEITO, e é o que substitui o heartbeat no painel: se nenhuma task executou em 45 min, ou o beat parou, ou o worker parou, ou a fila esvaziou. Nenhuma métrica de 'beat vivo' é publicada pelo backend (não há como afirmar isso só com `/metrics`), então este painel não promete uma série que não existe.",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
