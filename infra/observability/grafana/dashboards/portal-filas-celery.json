          "editorMode": "code",
          "expr": "sum(increase(portal_celery_tasks_total{ambiente=\"$ambiente\"}[45m]))",
          "legendFormat": "execuções",
          "range": true,
          "instant": true,
          "format": "time_series",
          "refId": "A"
