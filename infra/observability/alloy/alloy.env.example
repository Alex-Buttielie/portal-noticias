# Grafana Alloy — exemplo de ambiente (UM POR AMBIENTE).
#
# Copie para /etc/portal/alloy-<ambiente>.env na VPS, com modo 0640 e owner do
# usuário que roda o Alloy:
#   sudo install -d -m 0750 -o <USUARIO_ALLOY> -g <GRUPO> /etc/portal
#   sudo install -m 0640 -o <USUARIO_ALLOY> -g <GRUPO> \
#        infra/observability/alloy/alloy.env.example /etc/portal/alloy-prod.env
#   sudo editor /etc/portal/alloy-prod.env
#
# NUNCA commite o arquivo preenchido e NUNCA envie os valores por chat: este
# arquivo tem só nomes de variável. Os valores de `*_TOKEN` saem do painel do
# Grafana Cloud (Mimir "Push" e Loki "Push") e são segredos.
#
# TODOS OS VALORES DESTE ARQUIVO SÃO DE EXEMPLO. Nenhum é um valor real, e
# nenhum tem a FORMA de um valor real: os hosts usam o TLD reservado
# `.invalid` (RFC 2606), que nunca resolve; os tokens são frases ascii
#-delimitadas, não strings que pareçam credenciais; o usuário é `EXEMPLO`.
# `verificar-env.sh` REPROVA qualquer valor que ainda contenha um destes
# marcadores, o que impede a configuração em produção com a string de
# documentação.
#
# O que valida este arquivo: `infra/observability/alloy/verificar-env.sh`, que
# roda no `ExecStartPre` da unit do Alloy. Sem os valores obrigatórios, o
# coletor NÃO SOBE — é o comportamento oposto ao do backup que "terminava verde
# sem destino".

# --- Identidade do ambiente -------------------------------------------------
# Um coletor por ambiente. `ALLOY_AMBIENTE` vira rótulo EM BANDA em toda série
# coletada (via `prometheus.relabel` em `config.alloy`) e external label no
# remote_write. O rótulo em banda não é redundância: sem ele,
# `absent(up{ambiente="production", job="portal-api"})` — a regra
# `PortalTelemetriaAusente` — é incapaz de disparar, porque `absent()`
# compara a série inteira e `external_labels` não fazem parte dela.
ALLOY_AMBIENTE=production
# Release/commit implantado. Entra como informação de contexto nos painéis e
# ajuda a correlacionar erro com deploy. Não é label de série (cardinalidade).
ALLOY_RELEASE=EXEMPLO-substitua-pelo-sha-implantado
ALLOY_LOG_LEVEL=info

# --- Grafana Cloud: métricas (Mimir) ---------------------------------------
# URL de push: painel Mimir -> "Push" (ou "Add data source" -> Prometheus).
# O usuário é o número da stack (ex.: 123456) e o token é a API key da stack.
ALLOY_REMOTE_WRITE_URL=https://prometheus-EXEMPLO.invalid/api/prom/push
ALLOY_REMOTE_WRITE_USER=EXEMPLO
ALLOY_REMOTE_WRITE_TOKEN=EXEMPLO-token-de-exemplo-substitua-pela-api-key-da-stack

# --- Grafana Cloud: logs (Loki) --------------------------------------------
# URL de push: painel Loki -> "Push" / "Data source" -> URL de ingest.
ALLOY_LOKI_WRITE_URL=https://logs-EXEMPLO.invalid/loki/api/v1/push
ALLOY_LOKI_USER=EXEMPLO
ALLOY_LOKI_TOKEN=EXEMPLO-token-de-exemplo-substitua-pelo-token-de-escrita-do-loki

# --- Alvo de métricas do backend -------------------------------------------
# Host:porta do Gunicorn do ambiente (as portas 510x são do PM2, ver
# infra/nginx/portal-*.conf: dev 5101, homolog 5102, prod 5103). Não é a porta
# do Nginx (310x) nem a do Docker.
ALLOY_BACKEND_METRICS_ADDR=127.0.0.1:5103
# Arquivo (não a variável) com o MESMO valor de HEALTH_DETAIL_TOKEN do ambiente
# da aplicação — é esse o nome em `develop`; `OBSERVABILITY_METRICS_TOKEN` não
# existe. O `prometheus.scrape` usa `credentials_file` de propósito: o token
# fica em arquivo 0600, fora do environment do processo e fora deste
# repositório. `/metrics` devolve 401 para anônimo
# (`backend/config/health.py:414-418`), então token errado = `up=0` = painel
# vazio com o portal perfeito.
#   sudo install -m 0600 -o <USUARIO_ALLOY> -g <GRUPO> /dev/null /etc/portal/metrics-token
#   sudo sh -c 'printf %s "$HEALTH_DETAIL_TOKEN" > /etc/portal/metrics-token'
ALLOY_BACKEND_METRICS_TOKEN_FILE=/etc/portal/metrics-token
# Endereço da telemetria do próprio Alloy (endereço em memória do processo).
ALLOY_SELF_ADDR=127.0.0.1:12345

# --- Fontes de log ----------------------------------------------------------
# Log de acesso da borda. ATENÇÃO: `infra/nginx/http-cache.conf` de `develop`
# NÃO define nenhum `log_format` (verificado: zero ocorrências de `log_format`
# nos sete arquivos de `infra/nginx/`). Enquanto o `log_format portal_acesso`
# não existir, este arquivo não existe ou não é JSON, e o painel de acesso fica
# vazio. `verificar-env.sh` reprova se o arquivo não existir e AVISA se a
# primeira linha não parsear como JSON — o que transforma "painel vazio" em
# "instalação incompleta".
ALLOY_EDGE_LOG_GLOB=/var/log/nginx/portal-prod.access.log
# Logs JSON da aplicação, via PM2 (`~/.pm2/logs/portal-api-<env>-out.log`).
# O `-error.log` entra no mesmo glob para não perder stderr.
ALLOY_PM2_LOG_GLOB=/home/apps/portal-prod/.pm2/logs/portal-api-prod-*.log
# Saída JSON de `manage.py saude_filas --json`, uma linha por execução. É o
# canal pelo qual a saúde das filas entra na malha — e a única forma de ela
# entrar, porque `develop` NÃO expõe `portal_celery_queue_depth` nem
# `portal_celery_tasks_total`.
#
# O PRODUTOR deste arquivo é `infra/filas/pingar-filas.sh` (existe, testado),
# não a linha de 4 linhas que `infra/filas/PROVISIONAMENTO.md` §2.3 e o
# `config.alloy` ainda descrevem. A diferença que importa: o wrapper também
# dá o heartbeat ao cron monitor do Better Stack, e ROTACIONA o arquivo para
# ele não crescer sem limite (teto de `PING_FILAS_MAX_LINHAS`, ~2x em disco).
# Ver infra/observability/pingers/README.md.
#   3 * * * * /home/apps/portal-<amb>/infra/filas/pingar-filas.sh \
#       >> /var/log/portal/filas-pinger.log 2>&1
# Sem ele, `verificar-env.sh` reprova: é melhor o instalante ver "falta o
# arquivo" do que ver um painel de filas vazio e ler "nenhuma fila acumulada".
ALLOY_FILAS_JSON_PATH=/var/lib/portal-noticias/saude_filas.jsonl
# Allowlist de units do systemd para o journal, usada como regex ancorada em
# config.alloy. O valor é uma ALTERNÂNCIA e precisa vir entre aspas: sem as
# aspas o `|` vira pipe do shell ao carregar o arquivo e o `source` executa as
# units como comando. Vazio = não coleta (nunca "coleta tudo").
#
# Em `develop` a escolha entre systemd e PM1 ainda não foi feita
# (`infra/filas/PROVISIONAMENTO.md` §2.1), então ajuste ao que o ambiente
# realmente tiver. As units do exemplo são do cenário systemd.
ALLOY_JOURNAL_UNITS="celery-worker@prod.service|celery-beat@prod.service|nginx.service"
