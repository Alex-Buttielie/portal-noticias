# Grafana Alloy — exemplo de ambiente (UM POR AMBIENTE).
#
# Copie para /etc/portal/alloy-<ambiente>.env na VPS, com modo 0600 e owner do
# usuário que roda o Alloy:
#   sudo install -d -m 0750 -o <USUARIO_ALLOY> -g <GRUPO> /etc/portal
#   sudo install -m 0640 -o <USUARIO_ALLOY> -g <GRUPO> \
#        infra/observability/alloy/alloy.env.example /etc/portal/alloy-prod.env
#   sudo editor /etc/portal/alloy-prod.env
#
# NUNCA commite o arquivo preenchido e NUNCA envie os valores por chat: este
# arquivo tem só nomes de variável. Os valores de `*_TOKEN` saem do painel do
# Grafana Cloud (Mimir "Push" e Loki "Push") e são secretos.
#
# O que valida este arquivo: `infra/observability/alloy/verificar-env.sh`, que
# roda no `ExecStartPre` da unit do Alloy e no
# `scripts/observability/validar-infra.sh`. Sem os valores obrigatórios, o
# coletor NÃO SOBE — é o comportamento oposto ao do backup que "terminava verde
# sem destino".

# --- Identidade do ambiente -------------------------------------------------
# Um coletor por ambiente. `ALLOY_AMBIENTE` vira label em Loki e external label
# no Mimir: é ele que impede que os dados de dev apareçam como prod.
ALLOY_AMBIENTE=production
# Release/commit implantado. Entra como informação de contexto nos painéis e
# ajuda a correlacionar erro com deploy. Não é label de série (cardinalidade).
ALLOY_RELEASE=troque-aqui-pelo-sha-implantado
ALLOY_LOG_LEVEL=info

# --- Grafana Cloud: métricas (Mimir) ---------------------------------------
# URL de push: painel Mimir -> "Push" (ou "Add data source" -> Prometheus).
# O usuário é o número da stack (ex.: 123456) e o token é a API key da stack.
ALLOY_REMOTE_WRITE_URL=https://prometheus-NNNN.grafana.net/api/prom/push
ALLOY_REMOTE_WRITE_USER=NNN
ALLOY_REMOTE_WRITE_TOKEN=cole-aqui-a-api-key-da-stack

# --- Grafana Cloud: logs (Loki) --------------------------------------------
# URL de push: painel Loki -> "Push" / "Data source" -> URL de ingest.
ALLOY_LOKI_WRITE_URL=https://logs-NNNN.grafana.net/loki/api/v1/push
ALLOY_LOKI_USER=NNN
ALLOY_LOKI_TOKEN=cole-aqui-o-token-de-escrita-do-loki

# --- Alvo de métricas do backend -------------------------------------------
# Host:porta do Gunicorn do ambiente (as portas 510x são do PM2, ver
# infra/nginx/portal-*.conf: dev 5101, homolog 5102, prod 5103). Não é a porta
# do Nginx (310x) nem a do Docker.
ALLOY_BACKEND_METRICS_ADDR=127.0.0.1:5103
# Arquivo (não a variável) com o MESMO valor de OBSERVABILITY_METRICS_TOKEN do
# ambiente da aplicação. O `prometheus.scrape` usa `credentials_file` de
# propósito: o token fica em arquivo 0600, fora do environment do processo e
# fora deste repositório.
#   sudo install -m 0600 -o <USUARIO_ALLOY> -g <GRUPO> /dev/null /etc/portal/metrics-token
#   sudo sh -c 'printf %s "$OBSERVABILITY_METRICS_TOKEN" > /etc/portal/metrics-token'
ALLOY_BACKEND_METRICS_TOKEN_FILE=/etc/portal/metrics-token
# Endereço da telemetria do próprio Alloy (endereço em memória do processo).
ALLOY_SELF_ADDR=127.0.0.1:12345

# --- Fontes de log ----------------------------------------------------------
# Log de acesso da borda (definido em infra/nginx/http-cache.conf, um por
# ambiente; o glob cobre o log corrente).
ALLOY_EDGE_LOG_GLOB=/var/log/nginx/portal-prod.access.log
# Logs JSON da aplicação, via PM2 (`~/.pm2/logs/portal-api-<amb>-out.log`).
# O `-error.log` entra no mesmo glob para não perder stderr.
ALLOY_PM2_LOG_GLOB=/home/apps/portal-prod/.pm2/logs/portal-api-prod-*.log
# Allowlist de units do systemd para o journal, usada como regex ancorada em
# config.alloy. O valor é uma ALTERNÂNCIA e precisa vir entre aspas: sem as
# aspas o `|` vira pipe do shell ao carregar o arquivo e o `source` executa as
# units como comando. Vazio = não coleta (nunca "coleta tudo").
# Ajuste `celery-worker@<amb>.service` ao ambiente real.
ALLOY_JOURNAL_UNITS="celery-worker@prod.service|celery-beat@prod.service|celery-beat-heartbeat@prod.service|nginx.service"
