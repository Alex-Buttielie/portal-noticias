rules_version = "2";
service cloud.firestore {
  match /databases/{db}/documents {
    match /plans/{id} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /feature_flags/{id} { allow read: if true; allow write: if request.auth.token.admin == true; }
    match /users/{uid} { allow read, write: if request.auth.uid == uid; }
    match /{document=**} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
  }
}
