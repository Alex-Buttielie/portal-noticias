{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-4o",
  "small_model": "openai/gpt-4o-mini",
  "default_agent": "build",
  "instructions": ["AGENTS.md", "docs/ARCHITECTURE.md", "docs/PRD.md"],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "firebase": {
      "type": "local",
      "command": ["npx", "-y", "firebase-tools", "--help"],
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "docker *": "allow",
      "*": "ask"
    }
  },
  "share": "disabled",
  "autoupdate": "notify"
}
