# Copie para .env.local e ajuste se necess├írio.
# URL base do backend Django (ver backend/.env.example, CORS_ALLOWED_ORIGINS
# precisa incluir a origem deste frontend ÔÇö http://localhost:3000 por padr├úo).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL p├║blica deste frontend ÔÇö usada para montar links absolutos em SEO
# (canonical, Open Graph, JSON-LD, sitemap.xml, robots.txt, rss.xml). Ver
# frontend/lib/site.ts (run 20260903-1134-seo-lgpd-design-system).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense — monetização (opcional em dev). Com estes valores vazios,
# os AdsSlot seguem como placeholder visual e nenhuma chamada externa é
# feita. Em produção, preencha com o publisher ID (ca-pub-...) e os slots
# numéricos criados na conta AdSense (anqueie a conta + aguarde aprovação).
# ATENÇÃO: NEXT_PUBLIC_* entra no bundle no BUILD — rebuildar após preencher.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
# NEXT_PUBLIC_ADSENSE_SLOT_RETANGULO=
# NEXT_PUBLIC_ADSENSE_SLOT_VERTICAL=
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=

# --- Telemetria do frontend (observabilidade) -----------------------------
# Nenhuma variável nova é declarada aqui de propósito: o DSN do Sentry e as
# flags de consentimento técnico do frontend pertencem ao bloco de frontend da
# run 20260925-1020-observabilidade, e duplicar o nome aqui criaria duas
# fontes de verdade para a mesma variável.
#
# O contrato do lado do frontend, para quem for mexer aqui:
#   * sem consentimento técnico, NENHUM evento técnico sai do browser — nem
#     Sentry, nem Web Vitals, nem o endpoint técnico (critérios 5 e 27);
#   * com consentimento, o evento leva ambiente e release, e nunca leva token,
#     e-mail, IP completo, conteúdo ou URL com query string (critério 6);
#   * as variáveis de backend que importam para o mesmo fluxo
#     (SENTRY_TECHNICAL_CONSENT_DEFAULT, DJANGO_LOG_JSON) estão documentadas em
#     `backend/.env.example` e em `.env.production.example`.
