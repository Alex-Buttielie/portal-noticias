# Copie para .env.local e ajuste se necess├írio.
# URL base do backend Django (ver backend/.env.example, CORS_ALLOWED_ORIGINS
# precisa incluir a origem deste frontend ÔÇö http://localhost:3000 por padr├úo).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL p├║blica deste frontend ÔÇö usada para montar links absolutos em SEO
# (canonical, Open Graph, JSON-LD, sitemap.xml, robots.txt, rss.xml). Ver
# frontend/lib/site.ts (run 20260903-1134-seo-lgpd-design-system).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense — monetização (opcional em dev). Com estes valores vazios,
# os AdsSlot seguem como placeholder visual e nenhuma chamada externa é
# feita. Em produção, preencha com o publisher ID (ca-pub-...) e os slots
# numéricos criados na conta AdSense (anqueie a conta + aguarde aprovação).
# ATENÇÃO: NEXT_PUBLIC_* entra no bundle no BUILD — rebuildar após preencher.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Padrão por FORMATO — usado quando a posição abaixo não tem variável própria.
# NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
# NEXT_PUBLIC_ADSENSE_SLOT_RETANGULO=
# NEXT_PUBLIC_ADSENSE_SLOT_VERTICAL=
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=

# M-04 (run 20261012-1806-monetizacao-sprint1): um slot por POSIÇÃO, para o
# relatório do AdSense distinguir rendimento por lugar na página em vez de
# agrupar tudo no mesmo bloco por formato. Opcional — sem a variável da
# posição, o AdsSlot cai no padrão do formato acima (ver lib/anuncios.ts,
# `slotPorPosicao`/`resolverSlotAnuncio`). Ids dinâmicos (gerados em loop,
# ex. "categoria-infeed-0", "categoria-infeed-1") compartilham a variável do
# grupo (NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIA_INFEED).
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOPO=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_MANCHETES=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_ULTIMAS=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_POS_BOMBANDO=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_POS_REGIAO=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_POS_COLUNISTAS=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR_2=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_FOOTER=
# NEXT_PUBLIC_ADSENSE_SLOT_NOTICIA_TOPO=
# NEXT_PUBLIC_ADSENSE_SLOT_NOTICIA_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_NOTICIA_POS=
# NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIA_TOPO=
# NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIA_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIA_POS=
# NEXT_PUBLIC_ADSENSE_SLOT_BUSCAR_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_BUSCAR_HORIZONTAL=
# NEXT_PUBLIC_ADSENSE_SLOT_ARQUIVO_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_ARQUIVO_HORIZONTAL=
# NEXT_PUBLIC_ADSENSE_SLOT_PLANOS_HORIZONTAL=
# NEXT_PUBLIC_ADSENSE_SLOT_RADAR_RETANGULO=
