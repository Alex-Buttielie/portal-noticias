# Copie para .env.local e ajuste se necessário.
# URL base do backend Django (ver backend/.env.example, CORS_ALLOWED_ORIGINS
# precisa incluir a origem deste frontend — http://localhost:3000 por padrão).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL pública deste frontend — usada para montar links absolutos em SEO
# (canonical, Open Graph, JSON-LD, sitemap.xml, robots.txt, rss.xml). Ver
# frontend/lib/site.ts (run 20260903-1134-seo-lgpd-design-system).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
