# Copie para .env (ou exporte estas variáveis no seu shell) e ajuste os
# valores. Nenhum valor real de segredo deve ser commitado.

# SECRET_KEY sem valor default seguro: se DJANGO_SECRET_KEY não for definida
# (ou for deixada com o valor de fallback do settings.py) e DJANGO_DEBUG for
# false, a aplicação recusa subir (ImproperlyConfigured) — ver settings.py.
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-gerada
# Default real (quando a variável não é definida) é DJANGO_DEBUG=false —
# ligar debug é opt-in explícito, só para desenvolvimento local.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados — PostgreSQL é a engine padrão (ARCHITECTURE.md seção 1).
# DJANGO_DB_ENGINE=sqlite3 é um atalho de conveniência só para bootstrap
# local sem um servidor Postgres disponível; não usar em produção.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=brd_portal_noticias
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# E-mail — backend "console" (imprime no stdout) em dev/teste. Em produção,
# provedor transacional Resend (decisão 2026-09-17):
# DJANGO_EMAIL_BACKEND=config.email_resend.ResendEmailBackend + RESEND_API_KEY
# (re_...) + remetente de domínio VERIFICADO no painel do Resend.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@brdportalnoticias.local
RESEND_API_KEY=

FRONTEND_BASE_URL=http://localhost:3000

# OAuth Google (django-allauth) — preencher com credenciais reais do Google
# Cloud Console antes de testar o login social ponta a ponta (ver
# task-plan.md, seção "Dependências").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

TERMOS_VERSAO_ATUAL=1.0

# Assinatura — provedor de pagamento plugável (ARCHITECTURE.md seção 6).
# "manual" = placeholder sem chamada de rede (aprova na hora, para dev/teste
# e operação assistida do MVP). Trocar por um provedor real futuro é só mudar
# esta variável — nenhum código cliente muda (ideia incorporada do protótipo
# `testes-ia`, que usava PAYMENT_PROVIDER=fake para o mesmo fim).
ASSINATURA_PAYMENT_GATEWAY_PROVIDER=manual
# Mercado Pago (assinaturas recorrentes via /preapproval, sem SDK externo).
# Para ligar: ASSINATURA_PAYMENT_GATEWAY_PROVIDER=mercadopago + Access Token
# abaixo. Em sandbox use um token TEST-... (gera `sandbox_init_point` para
# testar o checkout sem cobrar de verdade); em produção, APP_USR-... + SANDBOX=false.
# Webhook: cadastre no painel do MP apontando para
# https://<DOMAIN_API>/api/assinatura/webhook/mercadopago/
ASSINATURA_MP_ACCESS_TOKEN=
ASSINATURA_MP_SANDBOX=true

# Celery + Redis (jobs assíncronos — ingestão periódica de notícias, etc.)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Ingestão longa: reentrega após queda do worker e no máximo 100 tarefas
# por processo filho (o valor é configurável sem novo deploy de código).
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# catalogo_noticias/ — ingestão, deduplicação, curadoria (run
# 20260902-0727-ingestao-noticias). As 4 fontes-semente (G1, UOL, CNN
# Brasil, Folha) são configuradas em config/settings.py
# (CATALOGO_NOTICIAS_FONTES_RSS), não aqui, pois exigem estrutura (lista de
# dicts nome/url), não um valor escalar simples.
CATALOGO_NOTICIAS_INTERVALO_INGESTAO_MINUTOS=15
# Reconciliação de segurança: após este TTL o feed é buscado sem validators
# para que um 304 falso não esconda uma perda local por mais de 6 horas.
CATALOGO_NOTICIAS_REVALIDACAO_COMPLETA_HORAS=6

# Critério de alta relevância (aciona fila de revisão humana): categoria
# sensível OU cluster com N+ fontes distintas. Ambos parametrizáveis sem
# alteração de código.
CATALOGO_NOTICIAS_CATEGORIAS_SENSIVEIS=política,economia,segurança pública
CATALOGO_NOTICIAS_LIMIAR_FONTES_ALTA_RELEVANCIA=3

# Limiar (0.0-1.0) de similaridade de título usado para agrupar itens no
# mesmo NewsCluster.
CATALOGO_NOTICIAS_DEDUP_LIMIAR_SIMILARIDADE=0.55

# Janela (horas) usada para comparar itens novos contra NewsItem já
# persistidos em execuções anteriores da task de ingestão, não só os itens do
# lote atual (code-review-contract.md run 20260902-0727-ingestao-noticias,
# Finding 3).
CATALOGO_NOTICIAS_DEDUP_JANELA_RECENTE_HORAS=24

# Teto superior de NewsItem recentes trazidos para o mesmo lote de
# agrupamento a cada execução, além da janela de tempo acima — evita
# crescimento sem limite do custo O(n^2) de agrupamento em dias de alto
# volume (code-review-contract.md run 20260902-0727-ingestao-noticias, 2a
# passada, Finding 5, minor).
CATALOGO_NOTICIAS_DEDUP_MAX_ITENS_RECENTES=300

# Limiar (0.0-1.0, SequenceMatcher.ratio() sobre o texto inteiro) acima do
# qual resumo_proprio é considerado cópia/quase-cópia de conteudo_bruto e o
# item é forçado para revisão humana (code-review-contract.md run
# 20260902-0727-ingestao-noticias, Finding 1, blocker).
CATALOGO_NOTICIAS_RESUMO_SIMILARIDADE_MAXIMA=0.6

# Proporção (0.0-1.0) do PRÓPRIO resumo que, se aparecer como trecho contínuo
# idêntico em qualquer parte do conteúdo bruto, é tratada como cópia parcial
# verbatim e força revisão humana — complementa
# CATALOGO_NOTICIAS_RESUMO_SIMILARIDADE_MAXIMA acima (code-review-contract.md
# run 20260902-0727-ingestao-noticias, 2a passada, Finding 2, major).
CATALOGO_NOTICIAS_RESUMO_TRECHO_COPIADO_MAXIMO=0.6

# SummarizationProvider — implementação concreta via API HTTP no formato
# "Chat Completions" (compatível com OpenAI e diversos provedores
# compatíveis). Nenhuma credencial real neste ambiente; provedor concreto de
# produção é decisão em aberto (ver ARCHITECTURE.md seção 8 e
# implementation-history.md do run 20260902-0727-ingestao-noticias).
CATALOGO_NOTICIAS_LLM_API_BASE_URL=https://api.openai.com/v1
CATALOGO_NOTICIAS_LLM_API_KEY=
CATALOGO_NOTICIAS_LLM_MODEL=gpt-4o-mini
CATALOGO_NOTICIAS_LLM_TIMEOUT_SEGUNDOS=30

# Quantos itens INDEPENDENTES entram em uma unica chamada HTTP ao provedor
# de LLM (reduz numero de chamadas/custo — um lote de 10 significa ~10x
# menos chamadas que o comportamento antigo de 1 chamada por item). Lote
# maior = menos chamadas, mas se a chamada inteira falhar, todos os itens
# daquele lote caem juntos na fila de revisao humana.
CATALOGO_NOTICIAS_LLM_TAMANHO_LOTE=10
# Teto de tokens de RESPOSTA por item (multiplicado pelo tamanho do lote) —
# evita pagar por respostas mais longas que o necessario para um resumo
# curto.
CATALOGO_NOTICIAS_LLM_MAX_TOKENS_POR_ITEM=220

# Preco estimado (USD por 1k tokens, entrada+saida somados) para calcular o
# custo de cada chamada ao provedor de LLM. Default 0.0003 = preco blended
# conservador do gpt-4o-mini (entrada $0.15/1M + saida $0.60/1M; ver
# derivacao em backend/config/settings.py). Ajustar quando o provedor de
# producao for escolhido.
CATALOGO_NOTICIAS_LLM_PRECO_USD_POR_1K_TOKENS=0.0003
# Teto de gasto diario estimado (USD): ao atingir, a ingestao para de chamar
# o provedor ate a virada do dia e os itens caem em revisao humana.
CATALOGO_NOTICIAS_LLM_TETO_GASTO_DIARIO_USD=5.0

# Feed público — P1 performance (run 20260923-1216-p1-feed-cache-indices):
# janela de listagem (horas) + TTLs curtos de cache (segundos). Staleness de
# ~45s no feed público é aceitável (o frontend já pratica ISR de 60s).
FEED_JANELA_HORAS=72
FEED_CACHE_TTL_SEGUNDOS=45
GATING_CACHE_TTL_SEGUNDOS=45
# Snapshot do vocabulário de autocomplete; reconstruir após expiração é
# barato e evita DISTINCT por keystroke.
FEED_AUTOCOMPLETE_CACHE_TTL_SEGUNDOS=300

# Frente D — microserviço de ingestão (feed/ + robôs). DESLIGADO por padrão
# (URL vazia = modo atual 100% local, sem nenhuma chamada de rede). Para
# ligar: definir a base (ex.: http://localhost:8001); o portal passa a tentar
# o microserviço primeiro nas leituras de feed/urgentes/detalhe (com fallback
# silencioso para o serviço local em caso de falha) e a sincronizar fontes de
# robôs em best-effort. O token vai no header X-API-Token (mesmo valor do
# INGESTAO_API_TOKEN do ingestao-service).
MICROSERVICO_INGESTAO_URL=
INGESTAO_API_TOKEN=

# Observabilidade — logs e Sentry (P0 itens 5,9,10).
# DJANGO_LOG_LEVEL respeitado por config/settings.py LOGGING root level.
# DJANGO_LOG_JSON=true ativa saída JSON (requer python-json-logger; fallback
# para verbose se ausente).
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_JSON=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup nativo da topologia PM2 (infra/backup/pg_backup_pm2.sh). Endpoint
# vazio usa o endpoint S3 oficial; preencha para Backblaze B2, Cloudflare R2
# ou outro serviço compatível. Sem bucket, o script mantém todos os backups
# locais (a retenção fica suspensa) e imprime um aviso explícito de que eles
# não protegem contra perda da VPS.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
